{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "OpenCut",
	"version": "0.9.0",
	"identifier": "dev.anderson17quadri.opencut",
	"build": {
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": [
			"msi",
			"nsis"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.ico"
		],
		"resources": {
			"resources/node": "node",
			"resources/server": "server"
		},
		"windows": {
			"webviewInstallMode": {
				"type": "downloadBootstrapper"
			}
		},
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCRjNENERBMEVGMzY3MQpSV1J4TnUrZ1RUMi9CdzFTcEhjNElDQnNKZXdtaGtCUHlRRGpUZ2JwVmNIMTZWZkZObWxHL1QzYgo=",
			"endpoints": [
				"https://github.com/anderson17quadri-cmd/opencut/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
