{
  "name": "opencut-mcp",
  "version": "0.6.0",
  "private": true,
  "description": "Claude Desktop extension that lets Claude edit videos in the OpenCut app",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=extension/server/index.js",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && mcpb validate extension/manifest.json && mcpb pack extension opencut.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "typescript": "^5"
  }
}
